---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Icon from '../../components/Icon.astro';
import { projectMedia } from '../../data/site';
export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, index, next: projects[(index + 1) % projects.length] },
  }));
}
interface Props { project: CollectionEntry<'projects'>; index: number; next: CollectionEntry<'projects'>; }
const { project, index, next } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);
const media = projectMedia[id];
const tagClass: Record<string, string> = { Web: '', Product: 'is-white', Graphic: '', Editorial: 'is-grey', Branding: 'is-white' };
---
<BaseLayout title={`${data.title} — Adrian Miras`} description={data.summary}>
  <article>
    <header class="case-hero container">
      <a class="pill" href="/work/"><span aria-hidden="true">←</span> All work</a>
      <span class="eyebrow">{String(index + 1).padStart(2, '0')} · {data.category} — {data.status === 'Concept' ? 'Identity exploration' : 'Selected project'}</span>
      <h1 class="headline case-title" data-split><strong>{data.title}</strong></h1>
      <p class="lead center" data-reveal>{data.subtitle}</p>
      <div class="case-tags" data-reveal>
        <span class={`chat-tag ${tagClass[data.category] ?? ''}`}>@{data.category.toLowerCase()}</span>
        {data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      {data.links.length > 0 && (
        <div class="case-links" data-reveal>
          {data.links.map((link, i) => <a class={i === 0 ? 'btn' : 'btn btn-ghost'} href={link.href} target="_blank" rel="noopener">{link.label} <Icon name="external" size={16} /></a>)}
        </div>
      )}
    </header>

    <div class="case-cover" data-video-host>
      <div class="case-cover-inner"><ProjectVisual id={id} variant={data.visual} title={data.title} priority play="auto" /></div>
    </div>

    <div class="case-layout container">
      <aside aria-label="Project details">
        <div class="case-sticky glass">
          <dl>
            <div><dt>The project</dt><dd>{data.summary}</dd></div>
            <div><dt>My involvement</dt><dd>{data.contribution}</dd></div>
            {data.tools.length > 0 && <div><dt>Tools</dt><dd class="tag-list">{data.tools.map(tool => <span class="tag">{tool}</span>)}</dd></div>}
          </dl>
          {!media?.cover && <p class="case-progress"><span class="status-dot"></span>Case study in progress</p>}
        </div>
      </aside>
      <div class="prose"><Content /></div>
    </div>

    {media?.reels && media.reels.length > 0 && (
      <section class="case-reels container" aria-labelledby="reels-title">
        <div class="section-head">
          <span class="eyebrow">Short-form video</span>
          <h2 id="reels-title" class="headline headline-md" data-split>Reels <span class="dim">from the shop floor.</span></h2>
        </div>
        <div class="reel-grid">
          {media.reels.map(reel => (
            <figure class="reel" data-reveal>
              <video controls playsinline preload="none" poster={reel.poster} aria-label={reel.caption}>
                <source src={reel.mp4} type="video/mp4" />
              </video>
              <figcaption>{reel.caption}</figcaption>
            </figure>
          ))}
        </div>
        {media.reelLinks && media.reelLinks.length > 0 && (
          <div class="reel-links">
            <span class="eyebrow">Watch on Facebook</span>
            {media.reelLinks.map((href, i) => <a class="pill" href={href} target="_blank" rel="noopener">Reel {String(i + 1).padStart(2, '0')} <span aria-hidden="true">↗</span></a>)}
          </div>
        )}
      </section>
    )}

    {media?.gallery.length > 0 && (
      <div class:list={['case-gallery container', { 'is-dense': media.gallery.length > 6 }]}>
        {media.gallery.map(image => (
          <figure class="case-figure" data-reveal>
            <a class="case-figure-frame" href={image.src} target="_blank" rel="noopener" data-cursor="Open">
              <img src={image.src} alt={image.alt} loading="lazy" decoding="async" width={image.width} height={image.height} />
            </a>
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="container">
      <a class="case-next" href={`/work/${next.id}/`} data-float-item data-cursor="Next">
        <span class="eyebrow">Next project</span>
        <span class="headline headline-md"><strong>{next.data.title}</strong></span>
        <span class="lead">{next.data.subtitle}</span>
        <span class="btn">View case study <Icon name="external" size={16} /></span>
        <div class="case-next-media" data-float-media aria-hidden="true"><ProjectVisual id={next.id} variant={next.data.visual} title={next.data.title} /></div>
      </a>
    </div>
  </article>
</BaseLayout>
