---
// Placeholder artwork in pure CSS (orange, black, grey and white only), sized with container units
// so it works from inline chips to full cards.
export type ArtVariant = 'web' | 'mobile' | 'print' | 'editorial' | 'tourism' | 'brand' | 'motion' | 'photo' | 'glass';
interface Props { variant: ArtVariant; }
const { variant } = Astro.props;
---
<span class:list={['art', `art-${variant}`]} aria-hidden="true">
  {variant === 'web' && (
    <span class="browser">
      <span class="bar"><i></i><i></i><i></i></span>
      <span class="body">
        <span class="side"><b></b><i></i><i></i><i></i></span>
        <span class="main"><span class="banner"></span><span class="tiles"><i></i><i></i><i></i></span></span>
      </span>
    </span>
  )}
  {variant === 'mobile' && (<><span class="phone phone-a"><span class="screen"><span class="dot"></span><span class="line"></span><span class="line short"></span></span></span><span class="phone phone-b"><span class="screen"><span class="ring"></span><span class="line"></span></span></span></>)}
  {variant === 'print' && (<><span class="sheet sheet-a">Make<br />it bold.</span><span class="sheet sheet-b">MAI<br />LIKHA</span><span class="sheet sheet-c"></span></>)}
  {variant === 'editorial' && (
    <span class="spread">
      <span class="page"><span class="kicker"></span><span class="title">The Voice</span><span class="cols"><i></i><i></i><i></i></span></span>
      <span class="page page-photo"><span class="sun"></span></span>
    </span>
  )}
  {variant === 'tourism' && (
    <>
      <span class="sunset"></span>
      <svg class="hills" viewBox="0 0 400 200" preserveAspectRatio="none"><path d="M0 140 70 80l60 50 70-90 80 80 50-40 70 60v160H0Z" fill="#2a2a2a" /><path d="M0 170 90 120l70 40 80-60 90 70 70-30v100H0Z" fill="#111111" /></svg>
      <span class="sea"></span>
    </>
  )}
  {variant === 'brand' && (<><span class="type">Aa</span><span class="swatches"><i></i><i></i><i></i><i></i></span></>)}
  {variant === 'motion' && (<><span class="play"></span><span class="timeline"><i></i><i></i><i></i></span></>)}
  {variant === 'photo' && (<span class="aperture"></span>)}
  {variant === 'glass' && (<><span class="orb orb-a"></span><span class="orb orb-b"></span><span class="orb orb-c"></span><span class="pane"></span></>)}
</span>

<style>
  /* Spans keep the art valid inside headings and paragraphs; this restores block layout at zero specificity. */
  :where(.art) :where(span, i, b) { display: block; }
  .art { position: absolute; inset: 0; overflow: hidden; container-type: size; isolation: isolate; }
  .art::after {
    content: ''; position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background: linear-gradient(115deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / .16) 44%, rgb(255 255 255 / 0) 58%);
  }

  /* Web: a browser window over an orange bloom. */
  .art-web { background: radial-gradient(70% 70% at 70% 80%, #ff5b1f, transparent 70%), #111111; }
  .browser { position: absolute; left: 11%; top: 15%; width: 78%; height: 74%; border-radius: 4cqmin; background: #fafafa; box-shadow: 0 6cqmin 12cqmin rgb(0 0 0 / .5); rotate: -5deg; overflow: hidden; }
  .bar { display: flex; gap: 1.4cqmin; align-items: center; height: 10%; padding-inline: 3cqmin; background: #e5e5e5; }
  .bar i { width: 2.2cqmin; height: 2.2cqmin; border-radius: 50%; background: #ff5b1f; }
  .bar i:nth-child(2) { background: #8a8a8a; }
  .bar i:nth-child(3) { background: #d4d4d4; }
  .body { display: grid; grid-template-columns: 22% 1fr; height: 90%; }
  .side { display: grid; align-content: start; gap: 2.6cqmin; padding: 4cqmin 3cqmin; background: #f0f0f0; }
  .side b { width: 60%; height: 4cqmin; border-radius: 1cqmin; background: #111111; }
  .side i { height: 1.8cqmin; border-radius: 1cqmin; background: #d4d4d4; }
  .main { display: grid; grid-template-rows: 1.2fr 1fr; gap: 3cqmin; padding: 4cqmin; }
  .banner { border-radius: 3cqmin; background: linear-gradient(120deg, #ff5b1f, #ff8a4c); }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4cqmin; }
  .tiles i { border-radius: 2.4cqmin; background: #e5e5e5; }
  .tiles i:first-child { background: #2a2a2a; }

  /* Mobile: two black phones on orange. */
  .art-mobile { background: linear-gradient(150deg, #ff5b1f, #ff8a4c 55%, #ffb37a); }
  .phone { position: absolute; width: 30%; aspect-ratio: 9 / 19; padding: 1.6cqmin; border-radius: 6cqmin; background: #0a0a0a; box-shadow: 0 6cqmin 12cqmin rgb(80 20 0 / .45); }
  .phone-a { left: 20%; top: 12%; rotate: -10deg; }
  .phone-b { left: 52%; top: 22%; rotate: 9deg; }
  .screen { position: relative; display: grid; align-content: end; gap: 2cqmin; height: 100%; padding: 4cqmin 3cqmin; border-radius: 4.6cqmin; overflow: hidden; background: linear-gradient(170deg, #2a2a2a, #111111); }
  .phone-b .screen { background: linear-gradient(170deg, #fafafa, #d4d4d4); }
  .screen .dot { position: absolute; left: 50%; top: 20%; width: 46%; aspect-ratio: 1; translate: -50% 0; border-radius: 50%; background: #ff5b1f; }
  .screen .ring { position: absolute; left: 50%; top: 18%; width: 56%; aspect-ratio: 1; translate: -50% 0; border-radius: 50%; border: 2.4cqmin solid #ff5b1f; }
  .screen .line { height: 2.6cqmin; border-radius: 2cqmin; background: #fafafa; }
  .phone-b .screen .line { background: #2a2a2a; }
  .screen .short { width: 60%; }

  /* Print: stacked posters on black. */
  .art-print { background: radial-gradient(60% 60% at 30% 20%, #2a2a2a, transparent 70%), #0a0a0a; }
  .sheet { position: absolute; width: 46%; aspect-ratio: 3 / 4; padding: 4cqmin; border-radius: 2cqmin; box-shadow: 0 6cqmin 12cqmin rgb(0 0 0 / .55); font: 800 9cqmin/.9 var(--display); letter-spacing: -.05em; }
  .sheet-a { left: 12%; top: 16%; rotate: -12deg; background: #fafafa; color: #ff5b1f; }
  .sheet-b { left: 40%; top: 10%; rotate: 6deg; background: #ff5b1f; color: #0a0a0a; font-size: 12cqmin; }
  .sheet-c { left: 30%; top: 46%; width: 30%; rotate: -3deg; background: radial-gradient(circle at 50% 40%, #0a0a0a 0 30%, #d4d4d4 31% 100%); }

  /* Editorial: a magazine spread on grey. */
  .art-editorial { background: linear-gradient(160deg, #d4d4d4, #a3a3a3); }
  .spread { position: absolute; left: 9%; top: 18%; display: grid; grid-template-columns: 1fr 1fr; width: 82%; height: 64%; border-radius: 1.6cqmin; overflow: hidden; background: #fafafa; box-shadow: 0 6cqmin 14cqmin rgb(0 0 0 / .3); rotate: -3deg; }
  .page { display: grid; align-content: start; gap: 2.4cqmin; padding: 4cqmin; border-right: 1px solid #e5e5e5; }
  .page .kicker { width: 40%; height: 1.6cqmin; background: #ff5b1f; }
  .page .title { font: 800 8cqmin/.9 var(--display); letter-spacing: -.05em; color: #0a0a0a; }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6cqmin; }
  .cols i { height: 14cqmin; background: repeating-linear-gradient(#d4d4d4 0 .9cqmin, transparent .9cqmin 2.2cqmin); }
  .page-photo { position: relative; background: linear-gradient(180deg, #ff8a4c, #c2410c); }
  .page-photo .sun { position: absolute; left: 50%; top: 40%; width: 40%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: #fafafa; }

  /* Tourism: an orange sunset over black hills. */
  .art-tourism { background: linear-gradient(180deg, #ffb37a, #ff8a4c 40%, #ff5b1f 70%, #c2410c); }
  .sunset { position: absolute; left: 50%; top: 30%; width: 34%; aspect-ratio: 1; translate: -50% 0; border-radius: 50%; background: #fafafa; box-shadow: 0 0 16cqmin rgb(255 240 230 / .85); }
  .hills { position: absolute; left: 0; bottom: 18%; width: 100%; height: 40%; }
  .sea { position: absolute; left: 0; right: 0; bottom: 0; height: 19%; background: repeating-linear-gradient(#111111 0 2cqmin, #2a2a2a 2cqmin 3.4cqmin); }

  /* Brand: type specimen and swatches. */
  .art-brand { background: #0a0a0a; }
  .type { position: absolute; left: 10%; top: 8%; font: 800 52cqmin/1 var(--display); letter-spacing: -.07em; color: #ff5b1f; }
  .swatches { position: absolute; left: 10%; right: 10%; bottom: 12%; display: grid; grid-template-columns: repeat(4, 1fr); gap: 3cqmin; }
  .swatches i { aspect-ratio: 1; border-radius: 50%; background: #ff5b1f; }
  .swatches i:nth-child(2) { background: #ff8a4c; }
  .swatches i:nth-child(3) { background: #8a8a8a; }
  .swatches i:nth-child(4) { background: #fafafa; }

  /* Motion: a play button over an orange bloom. */
  .art-motion { background: radial-gradient(70% 60% at 30% 30%, #c2410c, transparent 70%), radial-gradient(60% 60% at 80% 80%, #ff5b1f, transparent 70%), #0a0a0a; }
  .play { position: absolute; left: 50%; top: 42%; width: 30%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: rgb(255 255 255 / .14); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .play::after { content: ''; position: absolute; left: 40%; top: 30%; width: 30%; height: 40%; background: #fafafa; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .timeline { position: absolute; left: 12%; right: 12%; bottom: 14%; display: grid; grid-template-columns: 2fr 1fr 3fr; gap: 2cqmin; }
  .timeline i { height: 3cqmin; border-radius: 2cqmin; background: rgb(255 255 255 / .8); }
  .timeline i:nth-child(2) { background: #ff5b1f; }

  /* Photo: a black lens aperture on grey. */
  .art-photo { background: linear-gradient(150deg, #8a8a8a, #2a2a2a); }
  .aperture { position: absolute; left: 50%; top: 50%; width: 58%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: conic-gradient(from 20deg, #0a0a0a 0 12%, #2a2a2a 12% 25%, #0a0a0a 25% 37%, #2a2a2a 37% 50%, #0a0a0a 50% 62%, #2a2a2a 62% 75%, #0a0a0a 75% 87%, #2a2a2a 87%); box-shadow: 0 0 0 4cqmin #e5e5e5, 0 8cqmin 16cqmin rgb(0 0 0 / .45); }
  .aperture::after { content: ''; position: absolute; inset: 34%; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fafafa, #ff8a4c 40%, #c2410c); }

  /* Glass: glossy orbs behind a frosted pane. */
  .art-glass { background: radial-gradient(80% 80% at 50% 100%, #2a2a2a, #0a0a0a); }
  .orb { position: absolute; border-radius: 50%; }
  .orb-a { left: 8%; top: 10%; width: 52%; aspect-ratio: 1; background: radial-gradient(circle at 30% 30%, #fafafa, #ff8a4c 40%, #c2410c); }
  .orb-b { right: 4%; top: 30%; width: 40%; aspect-ratio: 1; background: radial-gradient(circle at 30% 30%, #fafafa, #a3a3a3 50%, #2a2a2a); }
  .orb-c { left: 30%; bottom: 4%; width: 30%; aspect-ratio: 1; background: radial-gradient(circle at 30% 30%, #fafafa, #ff5b1f 55%, #c2410c); }
  .pane { position: absolute; inset: 24% 14%; border-radius: 5cqmin; background: rgb(255 255 255 / .1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .35); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
</style>
